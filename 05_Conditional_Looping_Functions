flow control statements

--break 
 tells bash to leave the loop whenever it encounters a break statement 

cout=1
while [ $cout -le 15 ]
do 
echo $count
((cont++))
if [ $count == 6 ]
then
echo "break"
break
fi
done

continue
 tells bash to stop the current iteration and start a new iteration altogether 
cout=1
while [ $cout -le 15 ]
do 
echo $count
((cont++))
if [ $count == 6 ]
then
echo "break"
continue
fi
done


